# Copy this file to .streamlit/secrets.toml for local testing (that file is git-ignored).
# On Streamlit Community Cloud, paste the same lines into: app menu > Settings > Secrets.
OPENALEX_API_KEY = "paste-your-openalex-key-here"
# Optional. Leave this line out entirely if you are not using Brave.
BRAVE_API_KEY = "paste-your-brave-key-here"
